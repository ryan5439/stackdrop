<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E7Q1WH4R00', {
        'send_page_view': true
      });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E7Q1WH4R00"></script>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Primary Meta Tags -->
    <title>Stackdrop AI Agent - Sign Up | Create Your AI Agent Account</title>
    <meta name="title" content="Stackdrop AI Agent - Sign Up | Create Your AI Agent Account">
    <meta name="description" content="Sign up for Stackdrop AI Agent. Get started with autonomous AI agents that can control your PC using natural language and computer vision.">
    <meta name="keywords" content="AI agent signup, Stackdrop AI, AI automation, desktop control, computer vision AI">
    <meta name="robots" content="index,follow">
    <meta name="author" content="Stackdrop">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://stackdrop.it/ai-agent/signup" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://stackdrop.it/ai-agent/signup">
    <meta property="og:title" content="Stackdrop AI Agent - Sign Up">
    <meta property="og:description" content="Sign up for Stackdrop AI Agent - AI-powered desktop control and automation">
    <meta property="og:image" content="https://stackdrop.it/images/og-image.png">
    <meta property="og:site_name" content="Stackdrop">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Stackdrop AI Agent - Sign Up">
    <meta name="twitter:description" content="Sign up for Stackdrop AI Agent - AI-powered desktop control">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="apple-touch-icon" href="/images/favicon.png">
    
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px 0;
        }
        .signup-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 50px;
            max-width: 500px;
            width: 100%;
            margin: 20px;
        }
        .logo {
            text-align: center;
            margin-bottom: 30px;
        }
        .logo i {
            font-size: 60px;
            color: #667eea;
            margin-bottom: 10px;
        }
        .logo h1 {
            font-size: 28px;
            font-weight: bold;
            color: #333;
            margin: 0;
        }
        .logo p {
            color: #999;
            font-size: 14px;
        }
        .form-control {
            padding: 12px;
            border-radius: 10px;
            border: 2px solid #e0e0e0;
            transition: all 0.3s;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102,126,234,0.25);
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: bold;
            transition: all 0.3s;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(102,126,234,0.4);
        }
        .plan-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        .plan-option {
            flex: 1;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            cursor: pointer;
            text-align: center;
            transition: all 0.3s;
        }
        .plan-option:hover {
            border-color: #667eea;
        }
        .plan-option.selected {
            border-color: #667eea;
            background: #f0f3ff;
        }
        .plan-option input[type="radio"] {
            display: none;
        }
        .divider {
            text-align: center;
            margin: 20px 0;
            color: #999;
        }
        .alert {
            border-radius: 10px;
        }
        .back-link {
            text-align: center;
            margin-top: 20px;
        }
        .back-link a {
            color: #667eea;
            text-decoration: none;
        }
        .back-link a:hover {
            text-decoration: underline;
        }
        .password-strength {
            height: 5px;
            margin-top: 5px;
            border-radius: 5px;
            background: #e0e0e0;
            transition: all 0.3s;
        }
        .password-strength.weak { width: 33%; background: #ff4444; }
        .password-strength.medium { width: 66%; background: #ffbb33; }
        .password-strength.strong { width: 100%; background: #00C851; }
    </style>
</head>
<body>
    <%- include('partials/site-nav') %>
    <div class="signup-container">
        <div class="logo">
            <i class="fas fa-robot"></i>
            <h1>Join Stackdrop AI Agent</h1>
            <p>Control your PC from anywhere</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <form action="/ai-agent/signup" method="POST" onsubmit="return validateForm()">
            <div class="form-group mb-3">
                <label><i class="fas fa-user"></i> Full Name</label>
                <input type="text" name="fullname" class="form-control" placeholder="John Doe" required>
            </div>

            <div class="form-group mb-3">
                <label><i class="fas fa-at"></i> Username</label>
                <input type="text" name="username" class="form-control" placeholder="johndoe" pattern="[a-zA-Z0-9_]{3,20}" required>
                <small class="text-muted">3-20 characters, letters, numbers, and underscores only</small>
            </div>

            <div class="form-group mb-3">
                <label><i class="fas fa-envelope"></i> Email</label>
                <input type="email" name="email" class="form-control" placeholder="john@example.com" required>
            </div>

            <div class="form-group mb-3">
                <label><i class="fas fa-lock"></i> Password</label>
                <input type="password" name="password" id="password" class="form-control" placeholder="Choose a strong password" minlength="8" required onkeyup="checkPasswordStrength()">
                <div class="password-strength" id="strength-bar"></div>
                <small id="strength-text" class="text-muted">Minimum 8 characters</small>
            </div>

            <div class="form-group mb-4">
                <label><i class="fas fa-lock"></i> Confirm Password</label>
                <input type="password" name="confirm_password" id="confirm_password" class="form-control" placeholder="Re-enter password" required>
            </div>

            <div class="plan-selector">
                <label class="plan-option selected" onclick="selectPlan('free')">
                    <input type="radio" name="plan" value="free" checked>
                    <div><strong>Free</strong></div>
                    <small>1000 API calls/month</small>
                </label>
                <label class="plan-option" onclick="selectPlan('pro')">
                    <input type="radio" name="plan" value="pro">
                    <div><strong>Pro</strong></div>
                    <small>Unlimited calls</small>
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg btn-block w-100">
                <i class="fas fa-user-plus"></i> Create Account
            </button>
        </form>

        <div class="divider">────── OR ──────</div>

        <div class="text-center">
            <p>Already have an account?</p>
            <a href="/ai-agent/login" class="btn btn-outline-primary">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
        </div>

        <div class="back-link">
            <a href="/"><i class="fas fa-arrow-left"></i> Back to Stackdrop</a>
        </div>
    </div>

    <script>
        function selectPlan(plan) {
            document.querySelectorAll('.plan-option').forEach(el => el.classList.remove('selected'));
            event.currentTarget.classList.add('selected');
        }

        function checkPasswordStrength() {
            const password = document.getElementById('password').value;
            const strengthBar = document.getElementById('strength-bar');
            const strengthText = document.getElementById('strength-text');
            
            let strength = 0;
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;

            strengthBar.className = 'password-strength';
            if (strength <= 1) {
                strengthBar.classList.add('weak');
                strengthText.textContent = 'Weak password';
                strengthText.className = 'text-danger';
            } else if (strength <= 3) {
                strengthBar.classList.add('medium');
                strengthText.textContent = 'Medium password';
                strengthText.className = 'text-warning';
            } else {
                strengthBar.classList.add('strong');
                strengthText.textContent = 'Strong password!';
                strengthText.className = 'text-success';
            }
        }

        function validateForm() {
            const password = document.getElementById('password').value;
            const confirm = document.getElementById('confirm_password').value;
            
            if (password !== confirm) {
                alert('Passwords do not match!');
                return false;
            }
            
            if (password.length < 8) {
                alert('Password must be at least 8 characters long!');
                return false;
            }
            
            return true;
        }
    </script>
    <%- include('partials/social-follow') %>
</body>
</html>

