<div class="homepage-introduction">
<div class="container">
<div class="row">
<div class="col-sm-6">
<h1>Choose the apps you want, then generate the installer below</h1>
<p class="homepage-tagline">No clicking Next over and over. No junk. Just pick your apps, generate the installer, and they all install automatically.</p>
<p>
<img src="/images/image.png" alt="Stackdrop Screenshot showing software selection interface" class="img-responsive img-rounded">
</p>
<div class="alert alert-warning">
<p><strong>New!</strong> Stackdrop now generates smaller and faster EXE file that automatically downloads and installs your selected applications.</p>
</div>
</div>
<div class="col-sm-3">
<h4>🔄 Latest Updates</h4>
<p>Our system scans daily and lists the apps it refreshed here.</p>
<% if (latestUpdates && latestUpdates.length) { %>
  <p class="small" style="margin-bottom:8px;"><%= latestUpdates.length %> apps updated in the last scan.</p>
  <div style="max-height:320px;overflow:auto;padding-right:6px;">
  <% latestUpdates.forEach(function(item) { %>
    <p style="margin:0 0 8px;">
      <strong><%= item.name %></strong><% if (item.version) { %> · <%= item.version %><% } %><br>
      <span class="small"><%= item.timeDisplay %></span>
    </p>
  <% }); %>
  </div>
<% } else { %>
  <p class="small text-muted">No updates in the latest run yet.</p>
<% } %>
</div>
<div class="col-sm-3">
<h2 style="color:#000;">Stackdrop Pro</h2>
