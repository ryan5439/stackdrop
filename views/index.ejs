        }
        .navbar .navbar-nav.navbar-right > li > a.nav-cta-pro {
            color: #0066cc !important; /* match theme blue */
            background: transparent;
            border: none;
            line-height: 20px;
            padding: 12px 8px; /* align with brand */
        }
        /* Ensure brand and nav anchors share the same vertical rhythm */
        .navbar .navbar-brand {
            padding-top: 12px;
            padding-bottom: 12px;
            line-height: 20px;
        }
        .navbar .navbar-nav > li > a { padding-top: 12px; padding-bottom: 12px; line-height: 20px; font-weight: 600; }
        .navbar .navbar-nav.navbar-right > li > a.nav-cta-pro:hover {
            text-decoration: underline;
            background: transparent;
        }
        
        /* Dashboard image expand/collapse functionality */
        .dashboard-image {
            width: 100%;
            max-width: 500px;
            border-radius: 8px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            border: 1px solid #e0e0e0;
            transition: all 0.3s ease;
            cursor: pointer;
            overflow: hidden;
            display: block;
            margin: 0 auto;
            -webkit-transform: translateZ(0);
            -webkit-backface-visibility: hidden;
            -webkit-perspective: 1000;
            transform: translateZ(0);
            backface-visibility: hidden;
            perspective: 1000;
        }
        
        .dashboard-image.expanded {
            max-width: 90vw;
            max-height: 90vh;
            width: auto;
            height: auto;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 24px 60px rgba(0,0,0,0.3);
            z-index: 1000;
            border-color: #0066cc;
            object-fit: contain;
            background-color: #fff;
            padding: 10px;
        }
        
        /* Step 3 image - 33% larger when clicked */
        .dashboard-image.step3.expanded {
            max-width: none;
            max-height: none;
            width: auto;
            height: auto;
            position: relative;
            top: auto;
            left: auto;
            transform: scale(1.33);
            box-shadow: 0 16px 40px rgba(0,0,0,0.2);
            z-index: 10;
            border-color: #0066cc;
            object-fit: contain;
            background-color: transparent;
            padding: 0;
        }
        
        /* Step 4 image - 7% larger when clicked */
        .dashboard-image.step4.expanded {
            max-width: none;
            max-height: none;
            width: auto;
            height: auto;
            position: relative;
            top: auto;
            left: auto;
            transform: scale(1.07);
