<script>
// Robust mobile navbar toggle (Bootstrap 3 + manual fallback)
(function(){
  function ensureToggle(){
    var $btn = $('.navbar-toggle');
    var $target = $('#main-navbar');
    if (!$btn.length || !$target.length) return;
    $btn.attr('data-target', '#main-navbar');
    function toggle(ev){
      if (ev) ev.preventDefault();
      // Try Bootstrap first if available
      try { if ($target.collapse) { $target.collapse('toggle'); return; } } catch(_) {}
      // Fallback: manual toggle of classes/styles
      var isOpen = $target.hasClass('in');
      if (isOpen) {
        $target.removeClass('in').css({ display: '', height: '0' });
        $btn.addClass('collapsed').attr('aria-expanded','false');
      } else {
        $target.addClass('in').css({ display: 'block', height: 'auto' });
        $btn.removeClass('collapsed').attr('aria-expanded','true');
      }
    }
    $btn.off('click.sd touchstart.sd');
    $btn.on('click.sd', toggle);
    $btn.on('touchstart.sd', toggle);
  }
  if (window.jQuery) { $(ensureToggle); } else { document.addEventListener('DOMContentLoaded', ensureToggle); }
})();

// Dashboard image expand/collapse functionality
function toggleImageExpand(img) {
  img.classList.toggle('expanded');
}

// Close expanded images when clicking anywhere on the page
document.addEventListener('click', function(event) {
  // Check if any images are currently expanded
  const expandedImages = document.querySelectorAll('.dashboard-image.expanded');
  
  // If there are expanded images and the click is not on an image
  if (expandedImages.length > 0 && !event.target.classList.contains('dashboard-image')) {
    // Close all expanded images
    expandedImages.forEach(img => {
      img.classList.remove('expanded');
    });
  }
});

</script>
