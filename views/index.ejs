            color: #1a2b3c;
            margin: 6px 0 18px 0;
            max-width: 560px;
            overflow-wrap: break-word;
        }
        @media (max-width: 480px) { .homepage-tagline { font-size: 17px; margin-bottom: 14px; } }
        .homepage-introduction h4 {
            color: #333;
            margin-bottom: 20px;
        }
        .alert-warning {
            background-color: #fff3cd;
            border-color: #ffeaa7;
            color: #856404;
