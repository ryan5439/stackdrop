<form method="post" action="/generate-installer">
<div class="container" style="margin-bottom: 16px;">
<h2 class="text-center" style="margin-bottom: 16px;">1. Choose the apps you want</h2>
</div>
<div>
<ul class="list-unstyled center-block app-grid">

<% Object.keys(apps).forEach(function(category) { %>
<li class="homepage-app-section <%= category === 'documents' ? 'cat-documents' : '' %>">
<h4 class="homepage-group-title"><% if (apps[category].icon) { %><i class="fas <%= apps[category].icon %>" aria-hidden="true"></i><% } %><span><%= apps[category].title %></span></h4>
<% if (apps[category].note) { %><small class="homepage-group-note"><%= apps[category].note %></small><% } %>
<ul class="list-unstyled">
<% apps[category].items.forEach(function(app) { %>
<li>
<label for="cb_<%= app.id %>" class="homepage-app-label<%= app.note ? ' homepage-app-label--with-note' : '' %>" title="<%= app.name %>">
<input type="checkbox" class="js-homepage-app-checkbox" name="apps" value="<%= app.id %>" id="cb_<%= app.id %>">
<% if (app.id === 'signal') { %>
<i class="fas fa-comment-dots" style="color: #3a76f0; font-size: 16px;"></i>
<% } else if (app.id === 'telegram') { %>
<i class="fab fa-telegram" style="color: #26a5e4; font-size: 16px;"></i>
<% } else if (app.id === 'bitwarden') { %>
<i class="fas fa-shield-alt" style="color: #175ddc; font-size: 16px;"></i>
<% } else if (app.id === 'mpchc') { %>
<i class="fas fa-film" style="color: #4b5563; font-size: 16px;"></i>
<% } else if (app.id === 'potplayer') { %>
<i class="fas fa-circle-play" style="color: #f5b301; font-size: 16px;"></i>
<% } else if (app.id === 'obsidian') { %>
<i class="fas fa-gem" style="color: #7c3aed; font-size: 16px;"></i>
<% } else if (app.id === 'joplin') { %>
<i class="fas fa-book-open" style="color: #1071d3; font-size: 16px;"></i>
<% } else if (app.id === 'calibre') { %>
<i class="fas fa-book" style="color: #8b5a2b; font-size: 16px;"></i>
<% } else if (app.id === 'crystaldiskinfo') { %>
<i class="fas fa-hard-drive" style="color: #2563eb; font-size: 16px;"></i>
<% } else if (app.id === 'notepad3') { %>
<i class="fas fa-file-lines" style="color: #16a34a; font-size: 16px;"></i>
<% } else if (app.id.includes('chrome')) { %>
<img src="data:image/svg+xml;base64," alt="Chrome" style="width: 16px; height: 16px; margin-right: 8px;">
<% } else if (app.id.includes('firefox')) { %>
<i class="fab fa-firefox-browser" style="color: #ff7139; font-size: 16px;"></i>
<% } else if (app.id.includes('edge')) { %>
<i class="fab fa-edge" style="color: #0078d4; font-size: 16px;"></i>
<% } else if (app.id.includes('opera')) { %>
