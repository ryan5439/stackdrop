        /* Ensure the whole page is white (override any theme backgrounds) */
        html, body { background: #ffffff !important; }
        .stackdrop-canvas, .navbar, .homepage-introduction, .container { background: #ffffff !important; }
        body { overflow-x: hidden; }
        /* Fix category columns being cramped: layout masonry items as columns */
        /* Balanced multi-column (masonry-like) layout: categories flow top-to-bottom
           and fill columns evenly, so one long category no longer stretches a whole row */
        .app-grid {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 32px;
            display: block !important;
            column-count: 5;
            column-gap: 20px;
            column-fill: balance;
            list-style: none;
            text-align: initial;
            float: none; /* prevent left float from theme */
        }
        .app-grid > li.homepage-app-section {
            list-style: none;
            display: inline-block;   /* keeps a category in one column (older Safari) */
            width: 100%;
            break-inside: avoid;
            -webkit-column-break-inside: avoid;
            page-break-inside: avoid;
            text-align: left;
            padding: 8px 4px;
            margin-bottom: 8px;
            box-sizing: border-box;
        }
        /* Category titles: larger/bolder, plain (no pill), flush with the app rows below */
        .app-grid > li.homepage-app-section h4 {
            font-size: 18px;            /* ~1.125rem (Bootstrap 3 sets html to 10px, so px is used) */
            font-weight: 700;
            color: #1a2b3c;
            line-height: 1.3;
            letter-spacing: 0.1px;
            background: none;
            border: 0;
            border-radius: 0;
            padding: 0;
            margin: 0 0 8px 0;
            overflow-wrap: anywhere;
            word-break: normal;
        }
        .app-grid > li.homepage-app-section { margin-bottom: 18px; }
        /* Title = one leading Font Awesome icon + text; the icon can never wrap onto its own line */
        .app-grid > li.homepage-app-section h4.homepage-group-title { display: flex; align-items: baseline; gap: 8px; }
        .homepage-group-title > i { flex: 0 0 20px; width: 20px; text-align: center; font-size: 16px; color: #0066cc; }
        .homepage-group-title > span { flex: 1 1 auto; min-width: 0; }
        .homepage-group-note { display: block; margin: -4px 0 6px 28px; font-size: 12px; color: #6c757d; font-weight: normal; }
        @media (max-width: 480px) {
            .app-grid > li.homepage-app-section h4 { font-size: 17px; color: #1a2b3c !important; }
        }
        @media (max-width: 1200px) { .app-grid { column-count: 4; } }
        @media (max-width: 991px) { .app-grid { column-count: 3; padding: 0 20px; } }
        @media (max-width: 767px) { .app-grid { column-count: 2; padding: 0 12px; column-gap: 14px; } }
        /* Phones (<=640px CSS px): one column, every group block visibly centered.
           Same breakpoint for column-count and centering. */
        @media (max-width: 640px) {
            /* One shared fixed-width column: every group (title, note, rows) uses the same
               centered block, so all checkboxes share one left edge down the page. */
            .app-grid { column-count: 1; padding: 0; }
            .app-grid > li.homepage-app-section {
                display: block; width: 300px; width: min(300px, 90vw); max-width: none;
                margin-left: auto; margin-right: auto; text-align: left;
            }
            .app-grid > li.homepage-app-section h4.homepage-group-title { justify-content: flex-start; text-align: left; }
            .app-grid > li.homepage-app-section .homepage-group-title > span { flex: 0 1 auto; }
            .app-grid > li.homepage-app-section > ul.list-unstyled {
                display: block; width: 100%; max-width: none;
                margin: 8px 0 0; text-align: left;
            }
        }
        .homepage-app-label { padding: 2px 0; }
        .homepage-app-label, .homepage-app-label i { font-size: 14px; }
        .homepage-app-label { align-items: flex-start; }
        .homepage-app-label input[type="checkbox"] { flex: 0 0 auto; margin-top: 3px; }
        .homepage-app-label > i, .homepage-app-label > img { flex: 0 0 18px; width: 18px; text-align: center; margin-top: 2px; }
        .homepage-app-label--with-note { align-items: flex-start; }
        .homepage-app-label--with-note input[type="checkbox"] { margin-top: 2px; }
        .homepage-app-text { display: block; line-height: 1.3; min-width: 0; flex: 1 1 auto; overflow-wrap: anywhere; }
        .homepage-app-note {
            display: block;
            font-size: 11px;
            color: #6c757d;
            font-weight: normal;
            line-height: 1.2;
            margin-top: 1px;
            white-space: normal;
        }
        /* Navbar call-to-action styles (plain website links) */
        .navbar .navbar-nav.navbar-right > li > a.nav-cta {
            font-weight: 600;
            padding: 12px 8px; /* align with brand */
            color: #0066cc !important;
            margin-left: 8px;
            border: none;
            border-radius: 0;
            background: transparent;
            line-height: 20px;
        }
        .navbar .navbar-nav.navbar-right > li > a.nav-cta:hover {
