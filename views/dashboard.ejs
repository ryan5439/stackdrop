<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-E7Q1WH4R00', {
      'send_page_view': true
    });
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-E7Q1WH4R00"></script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> - Stackdrop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
  <style>
    :root { --sd-primary:#0d6efd; --sd-bg:#f6f8fb; }
    body {
      background: radial-gradient(1000px 500px at 10% -10%, #e9f1ff, transparent),
                  radial-gradient(700px 350px at 110% 10%, #f7f9ff, transparent),
                  var(--sd-bg);
    }
    .sd-card { max-width: 980px; margin: 0 auto; border:1px solid rgba(13,110,253,0.08); box-shadow:0 10px 30px rgba(2,6,23,0.06); border-radius:14px; }
    .brand-mark { display:inline-flex; align-items:center; gap:.5rem; font-weight:700; color:#0b5ed7; text-decoration:none }
    .brand-dot { width:10px; height:10px; background:var(--sd-primary); border-radius:50%; display:inline-block }
    .device-item { padding:.5rem .75rem; border-bottom:1px solid #f0f2f7; display:flex; justify-content:space-between; align-items:center }
    .device-item:last-child { border-bottom:0 }
    .muted { color:#6c757d }
    .status-pill { display:inline-flex; align-items:center; gap:.4rem; padding:4px 10px; border-radius:9999px; font-weight:600; font-size:.85rem; border:1px solid #cde9d6; background:#eaf7ee; color:#2d7a46 }
  </style>
  <script>
  const SUPABASE_URL = "<%= supabaseUrl %>";
  const SUPABASE_ANON = "<%= supabaseAnon %>";
  const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON);
  async function ensureAuth() {
    const { data } = await sb.auth.getSession();
    if (!data || !data.session) { window.location.href = '/login'; return null; }
    
    // Store session token in cookie for server-side authentication
    if (data.session && data.session.access_token) {
      document.cookie = `sb_access_token=${data.session.access_token}; path=/; max-age=604800; SameSite=Lax`;
    }
    
    return data.session;
  }
  // Global variable for Pro status
  let isActive = false;

  async function loadDevices() {
    const session = await ensureAuth(); if (!session) return;
    // Show logged-in pill
    var ls = document.getElementById('loginStatus');
    if (ls) {
      ls.style.display = 'inline-flex';
      const em = (session.user && (session.user.email || session.user.user_metadata && session.user.user_metadata.email)) || '';
      ls.textContent = em ? `✓ You are logged in as ${em}` : '✓ You are logged in';
      
      // Show superadmin link if user is ryan5439@yahoo.com
      if (em === 'ryan5439@yahoo.com') {
        const adminLink = document.getElementById('superadminLink');
        if (adminLink) adminLink.style.display = 'inline-block';
      }
    }
    const token = session.access_token;

    // Immediate local check via Supabase session metadata
    const meta = (session.user && (session.user.user_metadata || session.user.raw_user_meta_data)) || {};
    isActive = false;
    try {
      const plan = String(meta.plan_status || '').toLowerCase();
      const paid = !!meta.paid;
      const until = meta.paid_until ? new Date(meta.paid_until) : null;
      isActive = (plan === 'active' || plan === 'paid' || paid || (until && until > new Date()));
    } catch(_) {}
    const proBtn = document.getElementById('proBtn');
    const proBadge = document.getElementById('proBadge');
    const downloadNavLink = document.getElementById('downloadNavLink');
    const downloadSection = document.getElementById('downloadSection');
    if (isActive) {
      if (proBtn) proBtn.style.display = 'none';
      if (proBadge) proBadge.style.display = 'inline-block';
      if (downloadNavLink) downloadNavLink.style.display = 'inline-block';
      if (downloadSection) downloadSection.style.display = 'block';
    }

    // Check entitlement and update Pro button label (server-confirmed)
    try {
      const userId = session.user && session.user.id;
      const hb = await fetch('/api/heartbeat?org_id=' + encodeURIComponent(userId || ''), { headers: { 'Authorization': 'Bearer ' + token }});
      const hbJson = await hb.json();
      let source = '';
      if (!isActive) {
        isActive = !!(hbJson && hbJson.on);
      }
      if (!isActive) {
        const acc = await fetch('/api/account/status', { headers: { 'Authorization': 'Bearer ' + token }});
        const accJson = await acc.json();
        isActive = !!(accJson && accJson.active);
        source = accJson && accJson.source || '';
      }
      if (isActive) {
        if (proBtn) { proBtn.style.display = 'none'; }
        if (proBadge) { proBadge.style.display = 'inline-block'; proBadge.title = source ? ('source: ' + source) : ''; }
        if (downloadNavLink) downloadNavLink.style.display = 'inline-block';
        if (downloadSection) downloadSection.style.display = 'block';
      }
    } catch(_) {}

    const res = await fetch('/api/devices', { headers: { 'Authorization': 'Bearer ' + token } });
    const json = await res.json();
    const list = document.getElementById('devices'); list.innerHTML = '';
    const items = json.devices || [];
    const usage = document.getElementById('usage'); if (usage) { usage.textContent = `(${items.length}/100 used)`; }
    items.forEach(function(d){
      const li = document.createElement('div'); li.className='device-item';
      const when = d.last_seen_at ? new Date(d.last_seen_at).toLocaleString() : '—';
      
      // Make device title clickable for Pro users
      const deviceTitle = isActive ? 
        `<strong><a href="#" onclick="viewDevice('${d.id}'); return false;" style="color: #0d6efd; text-decoration: none; cursor: pointer;">${(d.hostname || d.id || 'Unknown')}</a></strong>` :
        `<strong>${(d.hostname || d.id || 'Unknown')}</strong>`;
      
      li.innerHTML = `<div>
        <div>${deviceTitle}</div>
        <div class="text-secondary small">GUID: ${d.id}</div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small">Last seen: ${when}</span>
        <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteDevice('${d.id}')">Delete</button>
      </div>`;
      list.appendChild(li);
    });
    if (!items.length) {
      const empty = document.createElement('div'); empty.className='text-secondary';
      empty.textContent = 'No devices yet.'; list.appendChild(empty);
    }
  }
  function showPlanChooser(){
    var pc = document.getElementById('planChooser');
    if (pc) pc.style.display = 'block';
  }
  async function startProPlan(plan) {
    const session = await ensureAuth(); if (!session) return;
    try {
      const token = session.access_token;
      const resp = await fetch('/api/billing/create-checkout-session', {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify({ plan })
      });
      const json = await resp.json();
      if (json && json.url) { window.location.href = json.url; return; }
      alert('Unable to start checkout. Please try again.');
    } catch (e) {
      alert('Billing is not configured.');
    }
  }
  function viewDevice(deviceId) {
    console.log('viewDevice called with deviceId:', deviceId, 'isActive:', isActive);
    if (!isActive) {
      alert('This feature requires a Pro subscription. Please upgrade your account.');
      return;
    }
    console.log('Navigating to device page...');
    window.location.href = `/device?device=${encodeURIComponent(deviceId)}`;
  }

  async function deleteDevice(id){
    const session = await ensureAuth(); if (!session) return;
    if (!confirm('Remove this device from your account?')) return;
    const token = session.access_token;
    const resp = await fetch('/api/devices/' + encodeURIComponent(id), { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
    const json = await resp.json();
    if (json && json.ok) { loadDevices(); } else { alert('Could not delete device.'); }
  }
  window.addEventListener('load', loadDevices);
  </script>
</head>
<body class="min-vh-100 d-flex flex-column">
  <%- include('partials/site-nav') %>
  <div class="container d-flex justify-content-end align-items-center gap-2 pt-2">
    <span id="loginStatus" class="status-pill" style="display:none">✓ You are logged in</span>
    <a id="superadminLink" class="btn btn-danger btn-sm" href="/superadmin" style="display:none">🛡️ Superadmin</a>
    <a id="downloadNavLink" class="btn btn-outline-success btn-sm" href="/download/client" style="display:none">📥 Download Windows Client</a>
  </div>

  <main class="container py-5 flex-grow-1">
    <!-- Pro User Download Section -->
    <div id="downloadSection" class="sd-card bg-success text-white p-4 mb-4" style="display:none">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h3 class="h5 mb-2">🎉 Welcome to Stackdrop Pro!</h3>
          <p class="mb-0">Download the Windows client to get started managing your devices.</p>
        </div>
        <div>
          <a href="/download/client" class="btn btn-light btn-lg">
            📥 Download Windows Client
          </a>
        </div>
      </div>
    </div>
    
    <div class="sd-card bg-white p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h1 class="h4 mb-1">Customer Dashboard</h1>
          <p class="text-secondary mb-0">You are signed in. Your devices will appear below.</p>
        </div>
        <div class="d-flex gap-2">
          <button type="button" id="proBtn" class="btn btn-primary btn-sm" onclick="showPlanChooser()">Start Pro Subscription</button>
          <span id="proBadge" class="badge bg-success" style="display:none">Welcome to Pro Subscription</span>
          <a class="btn btn-outline-primary btn-sm" href="/login">Switch account</a>
        </div>
      </div>

      <!-- Inline plan chooser -->
      <div id="planChooser" class="alert alert-light border" style="display:none">
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <span class="me-2">Choose a plan:</span>
          <button type="button" class="btn btn-primary btn-sm" onclick="startProPlan('starter')">Start $2.99 (up to 20 PCs)</button>
          <button type="button" class="btn btn-primary btn-sm" onclick="startProPlan('pro100')">Start $14.99 (up to 100 PCs)</button>
        </div>
      </div>

      <h2 class="h6 text-uppercase text-secondary mt-3">Your Devices <small class="text-muted" id="usage"></small></h2>
      <div id="devices" class="mt-2"></div>
    </div>
  </main>

  <footer class="py-4 text-secondary small">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center">
        <p class="mb-0">© <script>document.write(new Date().getFullYear())</script> Stackdrop</p>
        <ul class="list-inline mb-0">
          <li class="list-inline-item"><a href="/" class="text-decoration-none">Home</a></li>
          <li class="list-inline-item mx-2">•</li>
          <li class="list-inline-item"><a href="/about" class="text-decoration-none">About</a></li>
          <li class="list-inline-item mx-2">•</li>
          <li class="list-inline-item"><a href="/help" class="text-decoration-none">Help</a></li>
          <li class="list-inline-item mx-2">•</li>
          <li class="list-inline-item"><a href="/feedback" class="text-decoration-none">Feedback</a></li>
          <li class="list-inline-item mx-2">•</li>
          <li class="list-inline-item"><a href="/superadmin" class="text-decoration-none" style="color: #dc3545; font-weight: 700;">🛡️ Superadmin</a></li>
        </ul>
      </div>
      <%- include('partials/social-follow') %>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>


