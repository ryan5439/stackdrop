  <script>
    let isExpanding = false;
    let isClosing = false;
    
    function handleImageLoad(img) {
      img.dataset.loaded = 'true';
      img.style.display = 'block';
      img.style.visibility = 'visible';
      img.style.opacity = '1';
      const placeholder = img.parentElement && img.parentElement.querySelector('.screenshot-placeholder');
      if (placeholder) {
        placeholder.style.display = 'none';
      }
    }
    
    function handleImageError(img) {
      img.dataset.loaded = 'false';
      img.style.display = 'none';
      const placeholder = img.parentElement && img.parentElement.querySelector('.screenshot-placeholder');
      if (placeholder) {
        placeholder.style.display = 'flex';
      }
    }
    
    function lockScreenshotStyles(img) {
      img.style.setProperty('display', 'block', 'important');
      img.style.setProperty('visibility', 'visible', 'important');
      img.style.setProperty('opacity', '1', 'important');
      img.style.setProperty('pointer-events', 'none', 'important');
      img.style.setProperty('transition', 'none', 'important');
      img.style.setProperty('animation', 'none', 'important');
      img.style.setProperty('will-change', 'auto', 'important');
      img.style.setProperty('transform', 'translateZ(0)', 'important');
      img.style.setProperty('backface-visibility', 'hidden', 'important');
      img.style.setProperty('-webkit-backface-visibility', 'hidden', 'important');
      img.style.setProperty('image-rendering', 'auto', 'important');
      
      ['mouseenter', 'mouseleave', 'mouseover', 'mousemove', 'mouseout', 'mousewheel', 'wheel'].forEach(function(eventType) {
        img.addEventListener(eventType, function(e) {
          e.stopImmediatePropagation();
          e.preventDefault();
          return false;
        }, true);
      });
    }
    
    window.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.screenshot-img').forEach(function(img) {
        if (img.complete && img.naturalHeight !== 0) {
          handleImageLoad(img);
        } else {
          const placeholder = img.parentElement && img.parentElement.querySelector('.screenshot-placeholder');
          if (placeholder && img.dataset.loaded !== 'true') {
            placeholder.style.display = 'flex';
          }
        }
        lockScreenshotStyles(img);
      });
      
      setupScreenshotHandlers();
    });
    
    function setupScreenshotHandlers() {
      const overlay = document.getElementById('screenshotOverlay');
      
      document.querySelectorAll('.screenshot-container').forEach(function(container) {
        const img = container.querySelector('.screenshot-img');
        if (!img) return;
        
        container.addEventListener('click', function(e) {
          if (img.dataset.loaded !== 'true' || img.style.display === 'none') {
            return;
          }
          if (isExpanding || isClosing) {
            return;
          }
          e.stopPropagation();
          if (img.classList.contains('expanded')) {
            closeScreenshot(img);
          } else {
            expandScreenshot(img);
          }
        });
        
        img.addEventListener('click', function(e) {
          if (img.classList.contains('expanded')) {
            e.stopPropagation();
            if (!isClosing && !isExpanding) {
              closeScreenshot(img);
            }
          }
        });
        
        container.addEventListener('touchend', function(e) {
          if (img.dataset.loaded !== 'true' || img.style.display === 'none') {
            return;
          }
          if (isExpanding || isClosing) {
            return;
          }
          e.preventDefault();
          e.stopPropagation();
          if (img.classList.contains('expanded')) {
            closeScreenshot(img);
          } else {
            expandScreenshot(img);
          }
        }, { passive: false });
      });
      
      if (overlay) {
        overlay.addEventListener('click', function(e) {
          const expandedImg = document.querySelector('.screenshot-img.expanded');
          if (e.target === this && expandedImg) {
            e.stopPropagation();
            if (!isClosing && !isExpanding) {
              closeScreenshot(expandedImg);
            }
          }
        });
        
        overlay.addEventListener('touchend', function(e) {
          const expandedImg = document.querySelector('.screenshot-img.expanded');
          if (e.target === this && expandedImg) {
            e.preventDefault();
            e.stopPropagation();
            if (!isClosing && !isExpanding) {
              closeScreenshot(expandedImg);
            }
          }
        }, { passive: false });
      }
    }
    
    function expandScreenshot(img) {
      if (isExpanding || isClosing || !img) return;
      
      isExpanding = true;
      const overlay = document.getElementById('screenshotOverlay');
      if (!overlay) {
        isExpanding = false;
        return;
      }
      
      const scrollY = window.scrollY;
      document.body.style.top = `-${scrollY}px`;
      
      overlay.style.display = 'block';
      overlay.style.background = 'rgba(0,0,0,0.85)';
      overlay.style.opacity = '1';
      overlay.style.position = 'fixed';
      overlay.style.top = '0';
      overlay.style.left = '0';
      overlay.style.right = '0';
      overlay.style.bottom = '0';
      overlay.style.width = '100%';
      overlay.style.height = '100%';
      overlay.style.height = '100dvh';
      overlay.style.margin = '0';
      overlay.style.padding = '0';
      overlay.classList.add('active');
      
      img.classList.add('expanded');
      img.style.position = 'fixed';
      img.style.top = '50%';
      img.style.left = '50%';
      img.style.transform = 'translate(-50%, -50%)';
      img.style.zIndex = '10000';
      
      const isMobile = window.innerWidth <= 768;
      if (isMobile) {
        img.style.maxWidth = '95vw';
        img.style.maxHeight = '95vh';
        img.style.padding = '10px';
      } else {
        img.style.maxWidth = '90vw';
        img.style.maxHeight = '90vh';
        img.style.padding = '20px';
      }
      
      img.style.background = '#fff';
      img.style.borderRadius = '8px';
      img.style.boxShadow = '0 20px 60px rgba(0,0,0,0.5)';
      img.style.border = '3px solid #667eea';
      img.style.objectFit = 'contain';
      img.style.pointerEvents = 'auto';
      img.style.cursor = 'pointer';
      img.style.transition = 'none';
      img.style.animation = 'none';
      img.style.opacity = '1';
      img.style.willChange = 'auto';
      img.style.margin = '0';
      img.style.width = 'auto';
      img.style.height = 'auto';
      
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';
      document.body.classList.add('modal-open');
      
      isExpanding = false;
    }
    
    function closeScreenshot(img) {
      if (isClosing || isExpanding || !img) return;
      
      isClosing = true;
      const overlay = document.getElementById('screenshotOverlay');
      
      img.classList.remove('expanded');
      img.style.position = '';
      img.style.top = '';
      img.style.left = '';
      img.style.transform = '';
      img.style.zIndex = '';
      img.style.maxWidth = '';
      img.style.maxHeight = '';
      img.style.background = '';
      img.style.padding = '';
      img.style.borderRadius = '';
      img.style.boxShadow = '';
      img.style.border = '';
      img.style.objectFit = '';
      img.style.pointerEvents = '';
      img.style.transition = '';
      img.style.animation = '';
      img.style.opacity = '';
      img.style.willChange = '';
      img.style.margin = '';
      img.style.width = '';
      img.style.height = '';
      
      if (overlay) {
        overlay.classList.remove('active');
        overlay.style.display = 'none';
        overlay.style.opacity = '';
        overlay.style.position = '';
        overlay.style.top = '';
        overlay.style.left = '';
        overlay.style.right = '';
        overlay.style.bottom = '';
        overlay.style.width = '';
        overlay.style.height = '';
        overlay.style.margin = '';
        overlay.style.padding = '';
      }
      
      const scrollY = document.body.style.top;
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.width = '';
      document.body.style.top = '';
      document.body.classList.remove('modal-open');
      
      if (scrollY) {
        window.scrollTo(0, parseInt(scrollY || '0') * -1);
      }
      
      isClosing = false;
    }
    
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' || e.keyCode === 27) {
        const expandedImg = document.querySelector('.screenshot-img.expanded');
        if (expandedImg && !isClosing && !isExpanding) {
          closeScreenshot(expandedImg);
        }
      }
    });
  </script>
</body>
</html>

