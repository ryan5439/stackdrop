<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E7Q1WH4R00', {
        'send_page_view': true
      });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E7Q1WH4R00"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Confirmed - Stackdrop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .success-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 4rem 3rem;
            text-align: center;
            max-width: 500px;
            animation: slideIn 0.5s ease-out;
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .success-icon {
            font-size: 5rem;
            margin-bottom: 1.5rem;
            animation: bounce 1s ease-in-out;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }
        .success-title {
            color: #28a745;
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        .success-message {
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
        }
        .closing-message {
            color: #dc3545;
            font-size: 1.2rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }
        .close-btn {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s;
            display: inline-block;
            font-size: 1rem;
        }
        .close-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
    </style>
</head>
<body>
    <div class="success-container">
        <div class="success-icon">🎉</div>
        <h2 class="success-title">Congratulations!</h2>
        <p class="success-message">Your email has been successfully confirmed.</p>
        <p class="closing-message" id="closing-msg">
            <strong>Congrats! Your email is confirmed. Please click login below to continue!</strong>
        </p>
        <button class="close-btn" id="close-btn" onclick="window.location.href='/login'">Login to Continue</button>
    </div>

    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script>
        const SUPABASE_URL = "<%= supabaseUrl %>";
        const SUPABASE_ANON = "<%= supabaseAnon %>";
        const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON);

        function closeWindow() {
            console.log('Attempting to close window...');
            
            // Method 1: Standard window.close()
            try {
                window.close();
                console.log('Method 1: window.close() called');
            } catch (e) {
                console.log('Method 1 failed:', e);
            }
            
            // Method 2: Open blank and close
            try {
                window.open('', '_self').close();
                console.log('Method 2: open blank and close called');
            } catch (e) {
                console.log('Method 2 failed:', e);
            }
            
            // Method 3: Use about:blank trick
            try {
                window.location.replace('about:blank');
                setTimeout(() => window.close(), 100);
                console.log('Method 3: about:blank redirect');
            } catch (e) {
                console.log('Method 3 failed:', e);
            }
            
            // Method 4: Close with opener reference
            try {
                if (window.opener && !window.opener.closed) {
                    window.opener.focus();
                    window.close();
                    console.log('Method 4: close with opener focus');
                }
            } catch (e) {
                console.log('Method 4 failed:', e);
            }
            
            // Method 5: Self-assignment and close
            try {
                window.open('about:blank', '_self');
                window.close();
                console.log('Method 5: self-assign blank and close');
            } catch (e) {
                console.log('Method 5 failed:', e);
            }
            
            // If still not closed after 1 second, show button
            setTimeout(() => {
                if (document.getElementById('closing-msg')) {
                    document.getElementById('closing-msg').textContent = 'Please close this tab manually.';
                }
            }, 1000);
        }

        function showCloseButton() {
            document.getElementById('closing-msg').textContent = 'You can close this window now.';
            document.getElementById('close-btn').style.display = 'inline-block';
        }

        // Get tokens from URL hash
        const hash = window.location.hash.substring(1);
        const hashParams = new URLSearchParams(hash);
        const accessToken = hashParams.get('access_token');
        const refreshToken = hashParams.get('refresh_token');

        if (accessToken && refreshToken) {
            // Set the session
            sb.auth.setSession({
                access_token: accessToken,
                refresh_token: refreshToken
            }).then(() => {
                console.log('Email confirmed and session set!');
                console.log('User should return to the original signup tab.');
                // Don't redirect - let the user close this tab manually
                // The polling on the signup page will detect the confirmation
            }).catch((error) => {
                console.error('Error setting session:', error);
            });
        }
    </script>
</body>
</html>

