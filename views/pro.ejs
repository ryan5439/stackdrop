  <style>
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 0; color: #111; }
    .container { max-width: 980px; margin: 0 auto; padding: 24px; }
    h1 { margin: 0 0 16px; }
    h1, h2, h3 { color: #0066cc; }
    .card { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); align-items: stretch; }
    .muted { color: #666; }
    a { color: #0b6bcb; text-decoration: none; }
    a:hover { text-decoration: underline; }
    header, footer { background: #f8fafc; border-bottom: 1px solid #eef2f7; }
    footer { border-top: 1px solid #eef2f7; border-bottom: 0; }
    nav a { margin-right: 16px; font-weight: 600; padding: 12px 8px; line-height: 20px; color: #0066cc; text-decoration: none; }
    nav a:hover { text-decoration: underline; }
    .price { font-size: 32px; font-weight: 700; }
    ul.features { padding-left: 18px; }
    /* Pro CTA outside the pricing card */
    .pro-cta { text-align: center; margin: 24px 0 8px; }
    .pro-cta a {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, #0b6bcb, #00b4d8);
      color: #fff;
      padding: 14px 22px;
      border-radius: 12px;
      font-weight: 700;
      letter-spacing: 0.2px;
      box-shadow: 0 12px 20px rgba(11,107,203,0.18), 0 6px 10px rgba(0,0,0,0.05);
      transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
      text-decoration: none;
    }
    .pro-cta a:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 26px rgba(11,107,203,0.24), 0 8px 12px rgba(0,0,0,0.06);
      filter: brightness(1.03);
      text-decoration: none;
      color: #fff;
    }
    /* Equal-height cards and tidy spacing */
    .grid .card { display: flex; flex-direction: column; min-height: 280px; }
    .card h3 { margin-top: 0; }
    /* Dashboard showcase responsive design */
    .dashboard-grid {
      display: grid;
      gap: 24px;
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
    
    .dashboard-image {
      width: 100%;
      max-width: 500px;
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      border: 1px solid #e0e0e0;
      transition: all 0.3s ease;
      cursor: pointer;
      overflow: hidden;
      display: block;
      margin: 0 auto;
    }
    
    .dashboard-image.expanded {
      max-width: 90vw;
      max-height: 90vh;
      width: auto;
      height: auto;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      box-shadow: 0 24px 60px rgba(0,0,0,0.3);
      z-index: 1000;
      border-color: #0066cc;
      object-fit: contain;
      background-color: #fff;
      padding: 10px;
    }
    
    /* Force hardware acceleration for better Chrome performance */
    .dashboard-image {
      -webkit-transform: translateZ(0);
      -webkit-backface-visibility: hidden;
      -webkit-perspective: 1000;
      transform: translateZ(0);
      backface-visibility: hidden;
      perspective: 1000;
    }
    
    @media (max-width: 768px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      
      .dashboard-image {
        max-width: 100%;
      }
    }
    
    @media (max-width: 576px) {
      #btn-start-pro,
      #btn-start-starter,
      #btn-start-pro100 {
        display: block;
        width: 100%;
        text-align: center;
        margin-top: 8px;
      }
      .pro-cta a { width: 100%; justify-content: center; }
      
      .dashboard-grid {
        gap: 24px;
      }
    }
  </style>
