<body>
  <%- include('partials/site-nav') %>

  <main class="container">
    <div class="card" style="text-align:center; margin-top:8px;">
      <h1 style="margin-bottom:12px;">Stackdrop Pro</h1>
      <p style="margin:0 0 8px; font-size:1.35rem; font-weight:700; line-height:1.4; background:linear-gradient(135deg,#0066cc,#00b4d8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
        Auto-update every Windows app — fleet-wide, automatically.
      </p>
      <p class="muted" style="margin:0; font-size:1.05rem;">Fast, silent updates across all your PCs from one web dashboard.</p>
    </div>

    <div class="card" style="margin-top:16px;">
      <ul class="features" style="margin:0; line-height:1.8;">
        <li>Install a small Windows client on each PC</li>
        <li>Push updates and bulk installs from the web</li>
        <li>See every device, hostname, and last check-in via web-based interface</li>
        <li>Silent installs — no user interaction needed</li>
        <li>Specialized for domain networks — Windows GPO, Unix/Linux LDAP & Ansible</li>
      </ul>
    </div>

    <div class="pro-cta" style="margin-top:20px;">
      <a href="/signup-payment?plan=starter" aria-label="Start free trial" style="background:linear-gradient(135deg,#10b981,#059669); font-size:18px; padding:16px 28px;">
        Start Free Trial
      </a>
      <a href="/login" aria-label="Login to Pro Dashboard">Login</a>
      <a href="/signup-payment?plan=starter" id="btn-start-starter" aria-label="Start $2.99 plan">$2.99 / mo · 20 PCs</a>
      <a href="/signup-payment?plan=pro100" id="btn-start-pro" aria-label="Start Pro subscription">$14.99 / mo · 100 PCs</a>
    </div>

    <div class="card" style="margin-top:20px; text-align:center;">
      <img src="/images/dash2.jpg" alt="Stackdrop Pro Dashboard" class="dashboard-image" onclick="toggleImageExpand(this)" style="max-width:100%;">
    </div>

    <p class="muted" style="text-align:center; margin-top:16px; font-size:14px;">
      Need 200+ PCs? <a href="/feedback">Contact us</a>
    </p>
  </main>

  <footer>
    <div class="container">
      <p class="muted">© <%= new Date().getFullYear() %> Stackdrop</p>
      <p style="margin-top:4px;margin-bottom:0;"><span class="text-muted" style="font-size: 12px;color:#999;">Views: <%= typeof viewCount !== 'undefined' ? viewCount : '' %></span></p>
      <%- include('partials/social-follow') %>
    </div>
  </footer>

  <script>
    async function startPro(plan){
      try {
        // detect session
        var token = null;
        try {
          token = (typeof localStorage !== 'undefined') ? (localStorage.getItem('sb-access-token') || localStorage.getItem('supabase.auth.token')) : null;
          if (token) {
            try { var t = JSON.parse(token); token = (t && t.access_token) ? t.access_token : token; } catch(_){ }
          }
        } catch(_) {}
        
        // If user is already logged in, go directly to checkout
        if (token) {
          const resp = await fetch('/api/billing/create-checkout-session', {
            method: 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }, body: JSON.stringify({ plan })
          });
          const json = await resp.json().catch(()=>({}));
          if (json && json.url) { window.location.href = json.url; return; }
        }
        
        // If not logged in, redirect to unified signup page
        window.location.href = '/signup-payment?plan=' + encodeURIComponent(plan);
      } catch(_) { 
        window.location.href = '/signup-payment?plan=' + encodeURIComponent(plan); 
      }
    }
    (function(){
      function on(el, type, fn){ if (!el) return; el.addEventListener(type, fn, { passive:false }); }
      var cta = document.getElementById('btn-start-pro');
      on(cta, 'click', function(e){ e.preventDefault(); startPro('pro100'); });
      var s1 = document.getElementById('btn-start-starter');
      on(s1, 'click', function(e){ e.preventDefault(); startPro('starter'); });
    })();
    // Universal mobile navbar toggle (works for Bootstrap 3 and 5, or no framework)
    (function(){
      function ensureToggle(){
        var btn = document.querySelector('.navbar-toggle, .navbar-toggler');
        var targetSel = (btn && (btn.getAttribute('data-bs-target') || btn.getAttribute('data-target'))) || '#main-navbar';
        var target = document.querySelector(targetSel) || document.getElementById('main-navbar');
        if (!btn || !target) return;
        function toggle(ev){
          if (ev) ev.preventDefault();
          try {
            if (window.bootstrap && window.bootstrap.Collapse) {
              var c = window.bootstrap.Collapse.getOrCreateInstance(target);
              c.toggle();
              return;
            }
          } catch(_) {}
          var hasShow = target.classList.contains('show') || target.classList.contains('in');
          if (hasShow) {
            target.classList.remove('show');
            target.classList.remove('in');
            target.style.display = '';
            target.style.height = '0';
            btn.setAttribute('aria-expanded','false');
          } else {
            target.classList.add('show');
            target.classList.add('in');
            target.style.display = 'block';
            target.style.height = 'auto';
            btn.setAttribute('aria-expanded','true');
          }
        }
        btn.addEventListener('click', toggle, { passive:false });
        btn.addEventListener('touchstart', toggle, { passive:false });
      }
      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', ensureToggle); } else { ensureToggle(); }
    })();
    
    // Dashboard image expand/collapse functionality
    function toggleImageExpand(img) {
      img.classList.toggle('expanded');
    }
    
    // Close expanded images when clicking anywhere on the page
    document.addEventListener('click', function(event) {
      // Check if any images are currently expanded
      const expandedImages = document.querySelectorAll('.dashboard-image.expanded');
      
      // If there are expanded images and the click is not on an image
      if (expandedImages.length > 0 && !event.target.classList.contains('dashboard-image')) {
        // Close all expanded images
        expandedImages.forEach(img => {
          img.classList.remove('expanded');
        });
      }
    });
  </script>
</body>
</html>


