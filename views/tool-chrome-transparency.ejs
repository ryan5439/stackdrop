  <div class="screenshot-overlay" id="screenshotOverlay"></div>

  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script>
    let isExpanding = false;
    let isClosing = false;

    function handleImageLoad(img) {
      img.dataset.loaded = 'true';
      img.style.display = 'block';
      const placeholder = img.parentElement && img.parentElement.querySelector('.screenshot-placeholder');
      if (placeholder) placeholder.style.display = 'none';
    }

    function handleImageError(img) {
      img.dataset.loaded = 'false';
      img.style.display = 'none';
      const placeholder = img.parentElement && img.parentElement.querySelector('.screenshot-placeholder');
      if (placeholder) placeholder.style.display = 'flex';
    }

    function expandScreenshot(img) {
      if (isExpanding || isClosing || !img) return;
      isExpanding = true;
      const overlay = document.getElementById('screenshotOverlay');
      if (!overlay) { isExpanding = false; return; }

      const scrollY = window.scrollY;
      document.body.style.top = `-${scrollY}px`;
      overlay.style.display = 'block';
      overlay.classList.add('active');

      img.classList.add('expanded');
      img.style.pointerEvents = 'auto';
      img.style.cursor = 'pointer';

      const isMobile = window.innerWidth <= 768;
      img.style.maxWidth = isMobile ? '95vw' : '90vw';
      img.style.maxHeight = isMobile ? '95vh' : '90vh';
      img.style.padding = isMobile ? '10px' : '20px';

      document.body.classList.add('modal-open');
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';
      isExpanding = false;
    }

    function closeScreenshot(img) {
      if (isClosing || isExpanding || !img) return;
      isClosing = true;
      const overlay = document.getElementById('screenshotOverlay');

      img.classList.remove('expanded');
      img.style.pointerEvents = '';
      img.style.cursor = '';
      img.style.maxWidth = '';
      img.style.maxHeight = '';
      img.style.padding = '';

      if (overlay) {
        overlay.classList.remove('active');
        overlay.style.display = 'none';
      }

      const scrollY = document.body.style.top;
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.width = '';
      document.body.style.top = '';
      document.body.classList.remove('modal-open');
      if (scrollY) window.scrollTo(0, parseInt(scrollY || '0') * -1);

      isClosing = false;
    }

    window.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.screenshot-container').forEach(function(container) {
        const img = container.querySelector('.screenshot-img');
        if (!img) return;

        if (img.complete && img.naturalHeight !== 0) handleImageLoad(img);

        container.addEventListener('click', function(e) {
          if (img.dataset.loaded !== 'true' || isExpanding || isClosing) return;
          e.stopPropagation();
          if (img.classList.contains('expanded')) closeScreenshot(img);
          else expandScreenshot(img);
        });

        img.addEventListener('click', function(e) {
          if (img.classList.contains('expanded') && !isClosing && !isExpanding) {
            e.stopPropagation();
            closeScreenshot(img);
          }
        });
      });

      const overlay = document.getElementById('screenshotOverlay');
      if (overlay) {
        overlay.addEventListener('click', function(e) {
          const expandedImg = document.querySelector('.screenshot-img.expanded');
          if (e.target === this && expandedImg && !isClosing && !isExpanding) {
            closeScreenshot(expandedImg);
          }
        });
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' || e.keyCode === 27) {
        const expandedImg = document.querySelector('.screenshot-img.expanded');
        if (expandedImg && !isClosing && !isExpanding) closeScreenshot(expandedImg);
      }
    });
  </script>
