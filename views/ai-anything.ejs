        <a href="#" id="secretBtn" class="secret-badge" style="text-decoration: none; cursor: pointer;" onclick="event.preventDefault(); openModal();">
            <i class="fas fa-lock"></i> Top Secret Project in Development
        </a>

        <div class="countdown" id="countdown">
            <span>🔒</span> <span>🔒</span> <span>🔒</span>
        </div>

        <div class="features">
            <div class="feature-card">
                <div class="feature-icon">🤖</div>
                <div class="feature-title">AI-Powered</div>
                <div class="feature-desc">Next-generation artificial intelligence</div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🎥</div>
                <div class="feature-title">Video Analysis</div>
                <div class="feature-desc">Advanced computer vision capabilities</div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <div class="feature-title">Real-Time</div>
                <div class="feature-desc">Lightning-fast processing</div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🔐</div>
                <div class="feature-title">Secure</div>
                <div class="feature-desc">Enterprise-grade security</div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🤝</div>
                <div class="feature-title">Agents</div>
                <div class="feature-desc">Autonomous AI agents that work for you</div>
            </div>
        </div>

        <div class="cta">
            <p style="color: #a0aec0; margin-bottom: 20px; font-size: 18px;">
                We're working on something amazing. Stay tuned!
            </p>
            <a href="/feedback" class="btn-notify">
                <i class="fas fa-bell"></i> Get Notified When We Launch
            </a>
        </div>

        <div class="back-link">
            <a href="/"><i class="fas fa-arrow-left"></i> Back to Stackdrop</a>
        </div>
    </div>

    <!-- Modal/Popup -->
    <div id="aiAgentModal" class="modal-overlay" onclick="closeModalOnOverlay(event)">
        <div class="modal-content" onclick="event.stopPropagation();">
            <button class="modal-close" onclick="closeModal()" aria-label="Close">&times;</button>
            <h2>🤖 What Are AI Agents?</h2>
            <p>
                <strong>AI Agents</strong> are autonomous intelligent systems that can perform tasks, make decisions, and take actions on your behalf. Unlike traditional AI that just answers questions, AI agents can actually <strong>do things</strong> for you.
            </p>
            <h3 style="color: #667eea; margin-top: 30px; margin-bottom: 15px; font-size: 24px;">What They Do:</h3>
            <ul>
                <li><strong>Automate Tasks:</strong> Handle repetitive work automatically without your constant supervision</li>
                <li><strong>Make Decisions:</strong> Analyze information and choose the best course of action</li>
                <li><strong>Interact with Systems:</strong> Work with applications, websites, and services just like a human would</li>
                <li><strong>Learn & Adapt:</strong> Get better at tasks over time through experience</li>
                <li><strong>Work 24/7:</strong> Operate continuously, even when you're not around</li>
            </ul>
            <p style="margin-top: 30px;">
                Our AI agents use advanced <strong>computer vision</strong> to see your screen, <strong>natural language processing</strong> to understand your instructions, and <strong>real-time processing</strong> to respond instantly. They're designed with <strong>enterprise-grade security</strong> to keep your data safe while working autonomously.
            </p>
            <p style="color: #667eea; font-weight: 600; margin-top: 30px;">
                Think of them as your digital assistants that can see, understand, and act—not just chat!
            </p>
        </div>
    </div>

    <script>
        // Create animated stars
        const starsContainer = document.getElementById('stars');
        for (let i = 0; i < 100; i++) {
            const star = document.createElement('div');
            star.className = 'star';
            star.style.left = Math.random() * 100 + '%';
            star.style.top = Math.random() * 100 + '%';
            star.style.animationDelay = Math.random() * 3 + 's';
            starsContainer.appendChild(star);
        }

        // Animated countdown/mystery effect
        const symbols = ['🔒', '🤫', '👁️', '🎯', '✨', '🚀', '🔮', '💎'];
        const countdownEl = document.getElementById('countdown');
        
        setInterval(() => {
            const random = () => symbols[Math.floor(Math.random() * symbols.length)];
            countdownEl.innerHTML = `<span>${random()}</span> <span>${random()}</span> <span>${random()}</span>`;
        }, 2000);

        // Modal functions
        function openModal() {
            const modal = document.getElementById('aiAgentModal');
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            const modal = document.getElementById('aiAgentModal');
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }

        function closeModalOnOverlay(event) {
            if (event.target.id === 'aiAgentModal') {
                closeModal();
            }
        }

        // Close on Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeModal();
            }
        });
    </script>
