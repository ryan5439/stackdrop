<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Feedback - Stackdrop</title>
    <link href="https://ninite.com/static/css/bootstrap.min-ce67dc5fdca0309111ecf0491515e7a7.css" rel="stylesheet">
    <style>
        body { background: #f8f9fa; }
        .container { max-width: 820px; }
        .page-header { margin-top: 24px; }
        .help-block { color: #6c757d; }
    </style>
</head>
<body>
<nav class="navbar navbar-default navbar-static-top">
  <div class="container">
    <div class="navbar-header">
      <a class="navbar-brand" href="/">Stackdrop.It</a>
    </div>
    <ul class="nav navbar-nav navbar-right">
      <li><a href="/">Home</a></li>
      <li class="active"><a href="/feedback">Feedback</a></li>
    </ul>
  </div>
  </nav>

<div class="container">
  <div class="page-header">
    <h3>Send Feedback</h3>
    <p class="help-block">Have a feature idea or ran into an issue? Tell us below.</p>
  </div>

  <% if (typeof submitted !== 'undefined' && submitted) { %>
    <div class="alert alert-success">Thanks! Your feedback was submitted.</div>
  <% } %>

  <form method="post" action="/feedback" class="form-horizontal">
    <div class="form-group">
      <label class="col-sm-2 control-label" for="name">Name</label>
      <div class="col-sm-10">
        <input id="name" name="name" type="text" class="form-control" placeholder="Your name">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-2 control-label" for="email">Email</label>
      <div class="col-sm-10">
        <input id="email" name="email" type="email" class="form-control" placeholder="you@example.com">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-2 control-label" for="subject">Subject</label>
      <div class="col-sm-10">
        <input id="subject" name="subject" type="text" class="form-control" placeholder="What is this about?">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-2 control-label" for="message">Message</label>
      <div class="col-sm-10">
        <textarea id="message" name="message" class="form-control" rows="6" placeholder="Your message..."></textarea>
      </div>
    </div>
    <!-- Honeypot to deter bots -->
    <div style="display:none">
      <input type="text" name="website" tabindex="-1" autocomplete="off">
    </div>
    <div class="form-group">
      <div class="col-sm-offset-2 col-sm-10">
        <button type="submit" class="btn btn-primary">Send Feedback</button>
      </div>
    </div>
  </form>

  <hr>
  <p class="text-muted small">We store submissions to a local log for reliability. Email delivery is attempted if SMTP is configured.</p>
</div>

</body>
</html>

