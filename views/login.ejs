  <style>
    :root {
      --sd-primary: #0d6efd;
      --sd-bg: #f6f8fb;
    }
    body {
      background: radial-gradient(1000px 500px at 10% -10%, #e9f1ff, transparent),
                  radial-gradient(700px 350px at 110% 10%, #f7f9ff, transparent),
                  var(--sd-bg);
    }
    .sd-card {
      max-width: 320px;
      width: 100%;
      border: 1px solid rgba(13, 110, 253, 0.08);
      box-shadow: 0 10px 30px rgba(2, 6, 23, 0.08);
      border-radius: 14px;
    }
    .brand-mark {
      display: inline-flex; align-items: center; gap: .5rem;
      font-weight: 700; color: #0b5ed7; text-decoration: none;
    }
    .brand-dot { width: 10px; height: 10px; background: var(--sd-primary); border-radius: 50%; display: inline-block }
    .navbar-nav.navbar-right > li > a.nav-link {
      font-weight: 600;
      padding: 12px 8px;
      color: #0066cc !important;
      margin-left: 8px;
      border: none;
      border-radius: 0;
      background: transparent;
      line-height: 20px;
    }
    .navbar-nav.navbar-right > li > a.nav-link:hover {
      text-decoration: underline;
      background: transparent;
    }
    .navbar-nav.navbar-right > li > a.nav-cta-pro {
      color: #0066cc !important;
      background: transparent;
      border: none;
      line-height: 20px;
      padding: 12px 8px;
    }
    .navbar-nav.navbar-right > li > a.nav-cta-pro:hover {
      text-decoration: underline;
      background: transparent;
    }
    .muted-link { color: #6c757d; text-decoration: none }
    .muted-link:hover { color: #0d6efd; text-decoration: underline }
  </style>
