<body class="min-vh-100 d-flex flex-column">
  <%- include('partials/site-nav') %>

  <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-4">
    <div class="sd-card bg-white p-3 p-md-4">
      <div id="pro_notice" class="alert alert-danger py-2 px-3" role="alert" style="display:none; margin-bottom:10px;">
        You need to create an account and Sign in to start a Stackdrop PRO subscription.
      </div>
      <div class="text-center mb-3">
        <h1 class="h5 mb-1">Welcome back</h1>
        <p class="text-secondary mb-0 small">Sign in to manage your apps</p>
      </div>

      <ul class="nav nav-pills nav-fill mb-3" id="authTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active py-1" id="signin-tab" data-bs-toggle="pill" data-bs-target="#signin-pane" type="button" role="tab">Sign in</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link py-1" id="signup-tab" data-bs-toggle="pill" data-bs-target="#signup-pane" type="button" role="tab">Create account</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link py-1" id="forgot-tab" data-bs-toggle="pill" data-bs-target="#forgot-pane" type="button" role="tab">Reset Password</button>
        </li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="signin-pane" role="tabpanel">
          <form onsubmit="doLogin(); return false;">
            <div class="mb-2">
              <label class="form-label small mb-1">Email</label>
              <input id="email" type="email" class="form-control form-control-sm" placeholder="you@example.com" required>
            </div>
            <div class="mb-2">
              <label class="form-label small mb-1 d-flex justify-content-between align-items-center">
                <span>Password</span>
                <a href="#" class="muted-link" style="font-size: 11px; font-weight: normal;" onclick="showForgotPassword(); return false;">Forgot password?</a>
              </label>
              <input id="password" type="password" class="form-control form-control-sm" placeholder="Your password" required>
            </div>
            <button id="signinBtn" type="submit" class="btn btn-primary btn-sm w-100">Sign in</button>
          </form>
          <div class="text-center text-secondary mt-2 small">
            Or continue with
            <a class="muted-link" href="#" onclick="oauth('google')">Google</a>
            ·
            <a class="muted-link" href="#" onclick="oauth('azure')">Microsoft</a>
          </div>
          <div id="message" class="text-danger small mt-2"></div>
        </div>

        <div class="tab-pane fade" id="signup-pane" role="tabpanel">
          <form onsubmit="doSignup(); return false;">
            <div class="mb-2">
              <label class="form-label small mb-1">Email</label>
              <input id="signup_email" type="email" class="form-control form-control-sm" placeholder="you@example.com" required>
            </div>
            <div class="mb-2">
              <label class="form-label small mb-1">Password</label>
              <input id="signup_password" type="password" class="form-control form-control-sm" placeholder="At least 8 characters" required>
            </div>
            <div class="mb-2">
              <label class="form-label small mb-1">Confirm Password</label>
              <input id="signup_password2" type="password" class="form-control form-control-sm" placeholder="Re-enter password" required>
            </div>
            <button type="submit" class="btn btn-success btn-sm w-100">Create account</button>
          </form>
          <div id="signup_message" class="text-danger small mt-2"></div>
        </div>

        <div class="tab-pane fade" id="forgot-pane" role="tabpanel">
          <!-- Step 1: Enter Email -->
          <div id="forgot-step1">
            <p class="small text-secondary mb-2">Enter your email address and we'll send you a 6-digit code to reset your password.</p>
            <form onsubmit="sendResetCode(); return false;">
              <div class="mb-2">
                <label class="form-label small mb-1">Email</label>
                <input id="forgot_email" type="email" class="form-control form-control-sm" placeholder="you@example.com" required>
              </div>
              <button type="submit" class="btn btn-primary btn-sm w-100">Send Reset Code</button>
            </form>
            <div id="forgot_message_step1" class="small mt-2"></div>
          </div>

          <!-- Step 2: Enter Code & New Password -->
          <div id="forgot-step2" style="display:none;">
            <p class="small text-success mb-2">✓ Code sent! Check your email for the 6-digit code.</p>
            <form onsubmit="resetPassword(); return false;">
              <div class="mb-2">
                <label class="form-label small mb-1">6-Digit Code</label>
                <input id="reset_code" type="text" class="form-control form-control-sm" placeholder="123456" maxlength="6" pattern="[0-9]{6}" required>
              </div>
              <div class="mb-2">
                <label class="form-label small mb-1">New Password</label>
                <input id="reset_password" type="password" class="form-control form-control-sm" placeholder="At least 8 characters" required>
              </div>
              <div class="mb-2">
                <label class="form-label small mb-1">Confirm New Password</label>
                <input id="reset_password2" type="password" class="form-control form-control-sm" placeholder="Re-enter password" required>
              </div>
              <button type="submit" class="btn btn-success btn-sm w-100">Reset Password</button>
              <button type="button" class="btn btn-link btn-sm w-100 mt-1" onclick="resetForgotForm()">Back</button>
            </form>
            <div id="forgot_message_step2" class="small mt-2"></div>
          </div>
        </div>
      </div>

      <div class="text-center mt-3">
        <a class="muted-link small" href="/help">Need help?</a>
      </div>
    </div>
  </main>

  <footer class="py-3 text-secondary small">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center">
        <p class="mb-0">© <script>document.write(new Date().getFullYear())</script> Stackdrop</p>
        <ul class="list-inline mb-0">
          <li class="list-inline-item"><a href="/" class="text-decoration-none">Home</a></li>
          <li class="list-inline-item mx-2">•</li>
          <li class="list-inline-item"><a href="/about" class="text-decoration-none">About</a></li>
          <li class="list-inline-item mx-2">•</li>
          <li class="list-inline-item"><a href="/help" class="text-decoration-none">Help</a></li>
          <li class="list-inline-item mx-2">•</li>
          <li class="list-inline-item"><a href="/feedback" class="text-decoration-none">Feedback</a></li>
          <li class="list-inline-item mx-2">•</li>
          <li class="list-inline-item"><a href="/superadmin" class="text-decoration-none" style="color: #dc3545; font-weight: 700;">🛡️ Superadmin</a></li>
        </ul>
      </div>
      <%- include('partials/social-follow') %>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script>
    const SUPABASE_URL = "<%= supabaseUrl %>";
    const SUPABASE_ANON = "<%= supabaseAnon %>";
    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON);

    function setMsg(m) { document.getElementById('message').textContent = m || ''; }
    // Enter-to-submit on dashboard login
    document.addEventListener('DOMContentLoaded', function() {
      const emailEl = document.getElementById('email');
      const passEl = document.getElementById('password');
      const btn = document.getElementById('signinBtn');
      if (emailEl) emailEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); passEl && passEl.focus(); }});
      if (passEl) passEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); btn && btn.click(); }});
    });

    async function doLogin() {
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const { data, error } = await sb.auth.signInWithPassword({ email, password });
      if (error) {
        let errorMessage = error.message;
        if (errorMessage.toLowerCase().includes('failed to fetch') || errorMessage.toLowerCase().includes('network')) {
          errorMessage = 'Wrong username or password. Please check your credentials and try again.';
        }
        return setMsg(errorMessage);
      }
      
      // Store session token in cookie for server-side authentication
      if (data && data.session && data.session.access_token) {
        document.cookie = `sb_access_token=${data.session.access_token}; path=/; max-age=604800; SameSite=Lax`;
        console.log('✅ Logged in as:', email);
      }
      
      window.location.href = '/dashboard';
    }

    async function doSignup() {
      const email = document.getElementById('signup_email').value.trim();
      const password = document.getElementById('signup_password').value;
      const password2 = document.getElementById('signup_password2').value;
      const set = (m) => { document.getElementById('signup_message').textContent = m || ''; };
      set('');
      if (!email) return set('Please enter your email');
      if (!password || password.length < 8) return set('Password must be at least 8 characters');
      if (password !== password2) return set('Passwords do not match');
      try {
        const { data, error } = await sb.auth.signUp({
          email,
          password,
          options: { emailRedirectTo: window.location.origin + '/dashboard' }
        });
        if (error) return set(error.message);
        if (!data || !data.session) {
          setMsg('Check your email to confirm your account, then Sign in.');
          const tab = new bootstrap.Tab(document.querySelector('#signin-tab'));
          tab.show();
          return;
        }
        
        // Store session token in cookie for server-side authentication
        if (data.session && data.session.access_token) {
          document.cookie = `sb_access_token=${data.session.access_token}; path=/; max-age=604800; SameSite=Lax`;
          console.log('✅ Signed up as:', email);
        }
        
        window.location.href = '/dashboard';
      } catch (e) {
        set('Sign up failed. Please try again.');
      }
    }

    async function oauth(provider) {
      const { data, error } = await sb.auth.signInWithOAuth({ provider, options: { redirectTo: window.location.origin + '/dashboard' } });
      if (error) {
        let errorMessage = error.message;
        if (errorMessage.toLowerCase().includes('failed to fetch') || errorMessage.toLowerCase().includes('network')) {
          errorMessage = 'Authentication failed. Please try again.';
        }
        return setMsg(errorMessage);
      }
    }

    // ========================================
    // FORGOT PASSWORD FUNCTIONS
    // ========================================

    function showForgotPassword() {
      const tab = new bootstrap.Tab(document.querySelector('#forgot-tab'));
      tab.show();
    }

    async function sendResetCode() {
      const email = document.getElementById('forgot_email').value.trim();
      const msgEl = document.getElementById('forgot_message_step1');
      
      msgEl.className = 'small mt-2';
      msgEl.textContent = 'Sending code...';

      try {
        const response = await fetch('/api/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          msgEl.className = 'small mt-2 text-success';
          msgEl.textContent = '✓ ' + data.message;
          
          // Show step 2
          document.getElementById('forgot-step1').style.display = 'none';
          document.getElementById('forgot-step2').style.display = 'block';
        } else {
          msgEl.className = 'small mt-2 text-danger';
          msgEl.textContent = data.error || 'Failed to send reset code';
        }
      } catch (error) {
        msgEl.className = 'small mt-2 text-danger';
        msgEl.textContent = 'Network error. Please try again.';
      }
    }

    async function resetPassword() {
      const email = document.getElementById('forgot_email').value.trim();
      const code = document.getElementById('reset_code').value.trim();
      const newPassword = document.getElementById('reset_password').value;
      const confirmPassword = document.getElementById('reset_password2').value;
      const msgEl = document.getElementById('forgot_message_step2');

      msgEl.className = 'small mt-2';
      msgEl.textContent = '';

      // Validate passwords match
      if (newPassword !== confirmPassword) {
        msgEl.className = 'small mt-2 text-danger';
        msgEl.textContent = 'Passwords do not match';
        return;
      }

      if (newPassword.length < 8) {
        msgEl.className = 'small mt-2 text-danger';
        msgEl.textContent = 'Password must be at least 8 characters';
        return;
      }

      if (code.length !== 6 || !/^\d{6}$/.test(code)) {
        msgEl.className = 'small mt-2 text-danger';
        msgEl.textContent = 'Code must be 6 digits';
        return;
      }

      msgEl.className = 'small mt-2';
      msgEl.textContent = 'Resetting password...';

      try {
        const response = await fetch('/api/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, code, newPassword })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          msgEl.className = 'small mt-2 text-success';
          msgEl.textContent = '✓ ' + data.message;
          
          // Reset form and switch to Sign in tab after 2 seconds
          setTimeout(() => {
            resetForgotForm();
            const tab = new bootstrap.Tab(document.querySelector('#signin-tab'));
            tab.show();
            setMsg('Password reset successfully! Please Sign in with your new password.');
          }, 2000);
        } else {
          msgEl.className = 'small mt-2 text-danger';
          msgEl.textContent = data.error || 'Failed to reset password';
        }
      } catch (error) {
        msgEl.className = 'small mt-2 text-danger';
        msgEl.textContent = 'Network error. Please try again.';
      }
    }

    function resetForgotForm() {
      // Clear all fields
      document.getElementById('forgot_email').value = '';
      document.getElementById('reset_code').value = '';
      document.getElementById('reset_password').value = '';
      document.getElementById('reset_password2').value = '';
      document.getElementById('forgot_message_step1').textContent = '';
      document.getElementById('forgot_message_step2').textContent = '';
      
      // Show step 1
      document.getElementById('forgot-step1').style.display = 'block';
      document.getElementById('forgot-step2').style.display = 'none';
    }

    // Show red notice if redirected from PRO checkout attempt
    (function(){
      try {
        var p = new URLSearchParams(window.location.search || '');
        if (p.get('needPro') === '1') {
          var el = document.getElementById('pro_notice');
          if (el) el.style.display = 'block';
        }
      } catch (_) {}
    })();

    // Mobile navbar toggle fallback (works even without Bootstrap 5 JS)
    (function(){
      function ensureToggle(){
        var btn = document.querySelector('.navbar-toggler, .navbar-toggle');
        var targetSel = (btn && (btn.getAttribute('data-bs-target') || btn.getAttribute('data-target'))) || '#main-navbar';
        var target = document.querySelector(targetSel) || document.getElementById('main-navbar');
        if (!btn || !target) return;
        function toggle(ev){ ev.preventDefault(); var show = target.classList.contains('show') || target.classList.contains('in'); if (show) { target.classList.remove('show'); target.classList.remove('in'); target.style.display=''; target.style.height='0'; btn.setAttribute('aria-expanded','false'); } else { target.classList.add('show'); target.classList.add('in'); target.style.display='block'; target.style.height='auto'; btn.setAttribute('aria-expanded','true'); } }
        btn.addEventListener('click', toggle, { passive:false });
        btn.addEventListener('touchstart', toggle, { passive:false });
      }
      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', ensureToggle); } else { ensureToggle(); }
    })();

  </script>
</body>
</html>


