##
# stackdrop.it (primary) + stackdrop.us (redirect)
##

# HTTP — ACME challenges + redirects
server {
    listen 80;
    listen [::]:80;
    server_name stackdrop.it www.stackdrop.it stackdrop.us www.stackdrop.us;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/stackdrop/public;
        try_files $uri =404;
        default_type "text/plain";
    }

    location / {
        if ($host ~* ^(www\.)?stackdrop\.us$) {
            return 301 https://stackdrop.it$request_uri;
        }
        return 301 https://$host$request_uri;
    }
}

# HTTPS — primary site
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name stackdrop.it www.stackdrop.it;

    ssl_certificate /etc/letsencrypt/live/stackdrop.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stackdrop.it/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/stackdrop/public;
        try_files $uri =404;
        default_type "text/plain";
    }


    # BioCAD demo suite (static SPA) — /biocaddemo ONLY — do not remove
    location = /biocaddemo { return 302 /biocaddemo/; }
    location ^~ /biocaddemo/ {
        root /var/www/stackdrop/public;
        try_files $uri $uri/ /biocaddemo/index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
        add_header Pragma "no-cache";
        etag off;
    }

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTPS — stackdrop.us redirects to stackdrop.it
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name stackdrop.us www.stackdrop.us;

    ssl_certificate /etc/letsencrypt/live/stackdrop.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stackdrop.it/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/stackdrop/public;
        try_files $uri =404;
        default_type "text/plain";
    }

    return 301 https://stackdrop.it$request_uri;
}
